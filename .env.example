diff --git a/.env.example b/.env.example
index 6666666..7777777 100644
--- a/.env.example
+++ b/.env.example
@@ -1,10 +1,38 @@
 
-# EasyPost Logistics (Carrier Labels & Tracking)
-EASYPOST_API_KEY=ezpk_test_xxx
##############################
# Client (Vite) env vars
##############################
# Supabase (client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe (client)
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx
VITE_STRIPE_CLIENT_ID=ca_xxx

# API base (optional)
# If deploying frontend + serverless API on the same origin, you can set this to empty:
# VITE_API_BASE_URL=
VITE_API_BASE_URL=http://localhost:3000

# Sentry (client)
VITE_SENTRY_DSN=https://your-public-dsn@sentry.io/project

# Environment label (used by middleware/logging)
VITE_ENVIRONMENT=development
 
-# Sentry Monitoring (Observability)
-VITE_SENTRY_DSN=https://your-public-dsn@sentry.io/project
-SENTRY_DSN=https://your-private-dsn@sentry.io/project
-VITE_ENVIRONMENT=production
##############################
# Server / API (do NOT expose)
##############################
# Supabase (server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App base URL (server) - used for Stripe return URLs (should be your FRONTEND origin)
# Example: https://discflip.io
APP_BASE_URL=http://localhost:5173


# Stripe (server)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Gemini (server)
# Your current api/ai/gemini.ts reads process.env.API_KEY
API_KEY=your-gemini-key
GEMINI_API_KEY=your-gemini-key

# Sentry (server)
SENTRY_DSN=https://your-private-dsn@sentry.io/project

# EasyPost Logistics (server)
EASYPOST_API_KEY=ezpk_test_xxx

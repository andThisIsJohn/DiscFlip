##############################
# Client (Vite) env vars — put these in .env.local
##############################
# Supabase (client). Find both in Supabase → Project Settings → API.
# Leave VITE_SUPABASE_URL empty to run the app in offline "mock mode" with demo data.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Either name works: newer projects call it the "publishable" key, older ones the "anon" key.
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-or-anon-key
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Stripe (client)
VITE_STRIPE_PUBLIC_KEY=pk_test_xxx
VITE_STRIPE_CLIENT_ID=ca_xxx

# API base (optional). Leave empty when the site and the /api functions share a domain
# (Vercel, or local dev through the Vite proxy).
VITE_API_BASE_URL=

# Sentry (client, optional)
VITE_SENTRY_DSN=

# Environment label (used by middleware/logging)
VITE_ENVIRONMENT=development

##############################
# Server / API (Vercel environment variables — never expose these in the browser)
##############################
# Supabase (server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App base URL (server) - used for Stripe return URLs (your FRONTEND origin)
# Example: https://discflip.io
APP_BASE_URL=http://localhost:3000

# Stripe (server)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Gemini (server) — used by api/ai/gemini.ts for photo identification
GEMINI_API_KEY=your-gemini-key

# Sentry (server, optional)
SENTRY_DSN=

# EasyPost (server) — shipping labels and tracking
EASYPOST_API_KEY=ezpk_test_xxx
# The secret you type when creating the EasyPost webhook (verifies tracking updates)
EASYPOST_WEBHOOK_SECRET=make-up-a-long-random-string

# Protects the daily maintenance job (api/cron/maintenance.ts). Any long random string;
# Vercel sends it automatically when it runs the job.
CRON_SECRET=make-up-another-long-random-string
